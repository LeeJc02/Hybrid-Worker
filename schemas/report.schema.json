{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/hybrid-worker-ts/report.schema.json",
  "title": "Hybrid Worker Report",
  "type": "object",
  "required": ["status", "repo", "run_id", "workers", "merge", "timing", "usage"],
  "properties": {
    "status": { "type": "string" },
    "repo": { "type": "string" },
    "base_branch": { "type": "string" },
    "run_id": { "type": "string" },
    "model": { "type": "string" },
    "model_overridden": { "type": "boolean" },
    "execution_mode": { "enum": ["single_layer", "single_layer_dynamic_dag", "hierarchical"] },
    "scale_decision": { "type": "object" },
    "global_dag": { "type": "array" },
    "manager_subgraphs": { "type": "array" },
    "managers": { "type": "array" },
    "routing": { "type": "object" },
    "global_limits": { "type": "object" },
    "broker": { "type": "object" },
    "pilot": { "type": ["string", "null"] },
    "batches": { "type": "array" },
    "blocked_nodes": { "type": "array" },
    "circuit_breakers": { "type": "array" },
    "final_transaction": { "type": "object" },
    "events_file": { "type": "string" },
    "preflight": {
      "type": "object",
      "properties": {
        "ok": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "workers_requested": { "type": "array" },
    "execution_phases": { "type": "array" },
    "workers": { "type": "array" },
    "merge": { "type": "object" },
    "timing": { "type": "object" },
    "usage": { "type": "object" },
    "resume_commands": { "type": "object" },
    "environment_policy": { "type": "object" }
  },
  "additionalProperties": true
}
