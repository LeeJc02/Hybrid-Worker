{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/hybrid-worker-ts/workflow-seed.schema.json",
  "title": "Hybrid Worker v2 Workflow Seed",
  "type": "object",
  "required": ["version", "objective", "command_catalog", "final_verification"],
  "properties": {
    "version": { "const": 2 },
    "run_id": { "type": "string" },
    "objective": { "type": "string", "minLength": 1 },
    "command_catalog": { "$ref": "#/$defs/commandCatalog" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "kind": { "$ref": "#/$defs/nodeKind" },
          "required": { "type": "boolean" },
          "risk_floor": { "$ref": "#/$defs/risk" },
          "paths": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "final_verification": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "nodeKind": { "enum": ["scout", "planner", "shared_contract", "implementer", "verifier", "repair"] },
    "risk": { "enum": ["low", "medium", "high", "critical"] },
    "commandCatalog": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["argv"],
        "properties": {
          "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "cwd": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
