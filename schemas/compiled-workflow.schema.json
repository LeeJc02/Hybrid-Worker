{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex.local/hybrid-worker-ts/compiled-workflow.schema.json",
  "title": "Hybrid Worker v2 Compiled Workflow",
  "type": "object",
  "required": ["version", "objective", "command_catalog", "nodes", "final_verification"],
  "properties": {
    "version": { "const": 2 },
    "run_id": { "type": "string" },
    "base_commit": { "type": "string" },
    "objective": { "type": "string", "minLength": 1 },
    "command_catalog": { "$ref": "workflow-seed.schema.json#/$defs/commandCatalog" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "required", "depends_on", "paths", "command_refs", "risk"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "kind": { "$ref": "workflow-seed.schema.json#/$defs/nodeKind" },
          "required": { "type": "boolean" },
          "workstream": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "paths": { "type": "array", "items": { "type": "string" } },
          "ticket": { "type": "string", "minLength": 1 },
          "ticket_text": { "type": "string", "minLength": 1 },
          "command_refs": { "type": "array", "items": { "type": "string" } },
          "risk": { "$ref": "workflow-seed.schema.json#/$defs/risk" },
          "route": { "enum": ["fast", "balanced", "deep"] },
          "effort": { "enum": ["low", "medium", "high"] },
          "fallback": { "enum": ["fast", "balanced", "deep"] },
          "for_each": {
            "type": "object",
            "required": ["ref"],
            "properties": {
              "ref": { "$ref": "#/$defs/reference" },
              "item_name": { "type": "string" }
            },
            "additionalProperties": false
          },
          "when": {
            "type": "object",
            "required": ["ref"],
            "properties": {
              "ref": { "$ref": "#/$defs/reference" },
              "exists": { "type": "boolean" },
              "equals": {},
              "in": { "type": "array" }
            },
            "additionalProperties": false
          },
          "inputs": { "type": "object", "additionalProperties": { "$ref": "#/$defs/reference" } },
          "outputs": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "final_verification": { "type": "array", "items": { "type": "string" } },
    "shared_contract_frozen": { "type": "boolean" }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "required": ["node", "output"],
      "properties": { "node": { "type": "string" }, "output": { "type": "string" } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
